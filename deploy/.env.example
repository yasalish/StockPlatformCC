# deploy/.env.example — deployment configuration for the Docker stack.
#
#   cp deploy/.env.example deploy/.env
#   # fill in the three secrets, then:
#   docker compose --env-file deploy/.env up -d --build
#
# This is SEPARATE from the .env next to app.py on purpose. That one is for
# running `python app.py` locally and points at localhost; this one points at
# the compose service names. Passing --env-file makes compose read this file
# INSTEAD of ./.env, so the two can never be mixed up.
#
# Never commit deploy/.env — it is gitignored.

# ===========================================================================
# 1. Secrets — REQUIRED. compose refuses to start without them.
# ===========================================================================

# Signs session cookies. Must stay CONSTANT across restarts, and must be the
# same for every Gunicorn worker, or logins break at random.
#   python -c "import secrets; print(secrets.token_hex(32))"
STOCK_SECRET=

# PostgreSQL password. On the FIRST start this is what the database is created
# with; changing it later requires ALTER USER inside the container as well.
STOCK_DB_PASSWORD=

# Redis password (requirepass).
REDIS_PASSWORD=

# ===========================================================================
# 2. Iran / blocked-registry settings
# ===========================================================================
#
# Docker Hub does not serve Iranian IP addresses, so `docker compose build`
# and `pull` fail on the VPS unless REGISTRY points at a domestic mirror.
# It is prefixed to every base image (python, postgres, redis, debian) and MUST
# END WITH A SLASH. Leave it empty when building somewhere Docker Hub works.
#
# Candidate Iranian mirrors — these appear and disappear, so confirm one is
# reachable from the VPS before the first build:
#     REGISTRY=docker.arvancloud.ir/
#     REGISTRY=registry.docker.ir/
#     REGISTRY=docker.iranserver.com/
#     REGISTRY=hub.hamdocker.ir/
# Verify with:  docker pull <mirror>/debian:bookworm-slim
REGISTRY=

# Debian package mirror for the nginx image (nginx + the brotli modules).
# Domestic options: mirror.arvancloud.ir, debian.parspack.com, repo.iut.ac.ir
DEBIAN_MIRROR=deb.debian.org

# PyPI mirror for the application image. PyPI is usually reachable from Iran
# but slow; leave blank to use the default index.
#     PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# ===========================================================================
# 3. Host / networking
# ===========================================================================

# Used only as the CN of the self-signed certificate generated on first start.
# The nginx config itself is a catch-all, so no rebuild is needed to change it.
SERVER_NAME=localhost

HTTP_PORT=80
HTTPS_PORT=443

TZ=Asia/Tehran

# ===========================================================================
# 4. Optional — Google sign-in
# Leave blank to hide the «ورود با گوگل» button. The authorised redirect URI
# must be https://<your-domain>/auth/google/callback
# ===========================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================================================
# 5. PostgreSQL tuning — the order 01 values.
#
# Sized for 16 GB RAM + NVMe. On a smaller VPS, lower them HERE rather than
# editing docker-compose.yml:
#     8 GB box:  PG_SHARED_BUFFERS=2GB  PG_EFFECTIVE_CACHE_SIZE=6GB
#     4 GB box:  PG_SHARED_BUFFERS=1GB  PG_EFFECTIVE_CACHE_SIZE=3GB  PG_WORK_MEM=32MB
# ===========================================================================
PG_SHARED_BUFFERS=4GB
PG_WORK_MEM=64MB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_RANDOM_PAGE_COST=1.1
PG_PARALLEL_WORKERS_PER_GATHER=4
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_CONNECTIONS=100
PG_SHM_SIZE=1gb

STOCK_DB_NAME=Stock
STOCK_DB_USER=postgres

# ===========================================================================
# 6. Application tuning
# ===========================================================================

# Leave blank to let gunicorn.conf.py size itself from the host's CPU count
# (workers = CPUs-1, floored at 2 and capped at 4; threads = 4).
GUNICORN_WORKERS=
GUNICORN_THREADS=
GUNICORN_LOGLEVEL=info

STOCK_DB_POOL_MAX=8

REDIS_MAXMEMORY=512mb
ANALYTICS_CACHE_TTL=21600

# ===========================================================================
# 7. Observability (order 07)
# ===========================================================================

# Structured logging. `json` for production (one JSON object per line, with a
# request id); `text` for a readable local console.
LOG_FORMAT=json
LOG_LEVEL=INFO

# A request slower than this is logged at WARNING with its request id. This is
# the 200 ms threshold order 00 introduced, kept as the plan requires.
SLOW_REQUEST_MS=200

# Error tracking. EMPTY = disabled, and the app is unaffected.
#
# sentry.io is a foreign SaaS and this deployment is inside Iran, so point this
# at something you host: Sentry's server is open source, and GlitchTip speaks
# the same protocol with a much smaller footprint. Either runs on this VPS.
#   SENTRY_DSN=https://<key>@sentry.your-domain.ir/1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Shown on every event so a report can be tied to a deploy.
APP_RELEASE=

# ===========================================================================
# 8. Backups (order 07)
# ===========================================================================
# Local, self-hosted storage: ./backups on the host. Nothing is uploaded.

# Daily dump time, Tehran local.
BACKUP_AT=02:30
# Delete dumps older than this many days…
BACKUP_KEEP_DAYS=14
# …but never drop below this many, however old they are. A database that has
# been failing to dump for a month must not have its last good backup pruned.
BACKUP_KEEP_MIN=3
# Weekday for the automatic restore-into-a-scratch-database verification
# (1=Monday … 7=Sunday). 5 = Friday, a non-trading day in Iran.
BACKUP_VERIFY_WEEKDAY=5
