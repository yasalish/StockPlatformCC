# Copy this file to «.env» and adjust the values, then run the app.
# python-dotenv loads it automatically on startup.
# ---------------------------------------------------------------------------

# Session-cookie signing key. MUST be a long random string that stays CONSTANT
# across restarts (otherwise every user gets logged out on each restart).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
STOCK_SECRET=replace-with-a-long-random-secret

# Set to 1 only when the app is served over HTTPS (sends secure cookies).
COOKIE_SECURE=0

# PostgreSQL connection (overrides the defaults in db.py). The password default
# is currently hard-coded in db.py — set it here and remove it from the code.
STOCK_DB_NAME=Stock
STOCK_DB_USER=postgres
STOCK_DB_PASSWORD=
STOCK_DB_HOST=localhost
STOCK_DB_PORT=5432

# Redis — the shared analytics cache (cache.py). It replaced the per-process
# dicts in db.py, so all Gunicorn workers share one copy of every scan and
# clear_cache() invalidates every worker at once by bumping a version key.
# The app degrades gracefully: with no Redis it queries the materialized views
# directly and logs a warning instead of failing.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Alternatively set a single URL, which wins over the four variables above:
#   REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_URL=

# Local autostart (dev_boot.py / redis_boot.py). `python app.py` brings up the
# whole local stack — Redis, a Celery worker, and a browser — because an app that
# serves every read screen but cannot run a data update is not "started".
# Gunicorn/Compose never do any of this: there both are declared services.
#   BN_AUTOSTART_REDIS            1/0 — start Redis with the app (default 1)
#   REDIS_SERVER_EXE              path to redis-server, if not .tools/redis or PATH
#   BN_REDIS_BOOT_TIMEOUT         seconds to wait for it to answer (default 10)
#   BN_AUTOSTART_WORKER           1/0 — start the Celery workers too (default 1)
#   BN_WORKER_POOL                celery pool (default: solo on Windows)
#   BN_OPEN_BROWSER               1/0 — open the app once it is listening (default 1)

# The update queues (all optional). Fetching and maintenance are deliberately
# separate: --pool=solo runs one task at a time, so the multi-minute analytics
# rebuild on the fetch queue blocked every fetch, «توقف» and the reconciler
# behind it. Two names, two workers — see celery_app.py.
#   CELERY_FETCH_QUEUE            symbol fetches (default "updates")
#   CELERY_MAINTENANCE_QUEUE      rebuild / finalize / reconcile (default "maintenance")
#   UPDATE_STOP_INFLIGHT_GRACE    seconds a «توقف» waits for the symbol being
#                                 fetched before closing the job itself (default 180)
#   UPDATE_STALLED_HINT_AFTER     seconds of no progress before the page says so
#                                 (default 120)
#   ANALYTICS_REFRESH_EXPIRES     drop a queued rebuild older than this (default 1800)
#   ANALYTICS_REFRESH_LOCK_TTL    cross-process one-rebuild-at-a-time lock (default 1800)

# Cache tuning (all optional — the defaults are sensible).
#   ANALYTICS_CACHE_TTL           safety-net expiry in seconds (default 21600 = 6h)
#   REDIS_PREFIX                  key namespace (default "bn")
#   ANALYTICS_CACHE_LOCK_TTL      single-flight lock lifetime (default 180)
#   ANALYTICS_CACHE_LOCK_WAIT     how long a follower waits for the leader (default 60)
#   REDIS_RETRY_AFTER             seconds to stay degraded before retrying (default 20)
#   REDIS_CACHE_STATS             1/0 — keep hit/miss counters in Redis (default 1)
ANALYTICS_CACHE_TTL=21600

# Google sign-in (optional). Leave blank to hide the «ورود با گوگل» button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  http://127.0.0.1:5002/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging and error tracking (order 07). LOG_FORMAT=text is friendlier locally.
LOG_FORMAT=text
LOG_LEVEL=INFO
SLOW_REQUEST_MS=200
# Leave empty to disable Sentry entirely.
SENTRY_DSN=
